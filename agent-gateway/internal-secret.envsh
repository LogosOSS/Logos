#!/bin/sh
# Sourced by the nginx image's entrypoint before it runs envsubst over the
# configuration template. The internal secret is put into the configuration
# as the value of a quoted nginx string, so it is escaped here rather than
# substituted raw: a quote, a backslash or a dollar sign in the secret would
# otherwise end the string, start an escape or name a variable, and nginx
# would refuse to start.

logos_secret="${LOGOS_INTERNAL_SECRET:-}"
# A header value must be one line of printable ASCII. Counted rather than
# captured: a command substitution would drop a trailing line break.
if [ "$(printf '%s' "$logos_secret" | LC_ALL=C tr -d ' -~' | wc -c)" -ne 0 ]; then
    echo "LOGOS_INTERNAL_SECRET may contain printable ASCII characters only" >&2
    exit 1
fi
# Backslashes first, so the ones added for the quotes stay single. nginx has
# no escape for a dollar sign; ${logos_dollar} is a variable holding one.
LOGOS_INTERNAL_SECRET_NGINX="$(printf '%s' "$logos_secret" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\$/${logos_dollar}/g')"
export LOGOS_INTERNAL_SECRET_NGINX
unset logos_secret
